# Copy to scripts/.env (gitignored) and fill in values.
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
# Prompt caching (system prefix reused per run). Set to 0 to disable.
ANTHROPIC_PROMPT_CACHE=1
# After a successful run, open a PR if incidents.json changed (requires gh auth login).
INCIDENT_WATCHER_PUBLISH=0
